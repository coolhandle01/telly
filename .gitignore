# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets and local configuration. `*.local` above already covers .env.local,
# but a bare .env is the file people actually reach for, and it must never be
# committed even though the only thing that belongs in it is a public client ID.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage
coverage

# Mutation testing: the sandbox is a full copy of the project.
.stryker-tmp/
reports/

# A browser profile for driving the app via playwright: cookies, a live Google session and a
# saved password. Never committed, and nothing here reads it but the browser.
.browser/

# Snapshots and console logs written by Playwright while driving the app.
.playwright-mcp/

.claude/worktrees/
.claude/settings.local.json
