{
  "name": "testcard",
  "private": true,
  "version": "0.0.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "mutate": "stryker run",
    "typecheck": "tsc -b --noEmit",
